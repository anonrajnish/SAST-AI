# Frontend image. Build context is the repository root (see docker-compose.dev.yml).
# Multi-stage: build the Vite app, then serve it with `vite preview`.
FROM node:20-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

EXPOSE 4173
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "4173"]
