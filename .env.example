# Copy to .env and fill in. NEVER commit .env or real secrets.
# Values below are NON-SECRET placeholders. Generate real secrets at deploy time.

# === Application ===
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# Generate a real value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=generate-me-do-not-use-this-value

# === Database (override with real credentials via your secret store) ===
# POSTGRES_PASSWORD is required by docker-compose (it provisions Postgres and builds
# the backend DATABASE_URL). There is intentionally no default — generate a real value.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://sast_user:CHANGE_ME@localhost:5432/sastdb

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Key Encryption Key (injected at runtime; NOT stored here) ===
# Provided via Docker/K8s secret mounted to KEK_FILE (32 raw bytes, perms 400).
KEK_FILE=/run/secrets/sast_kek

# === Scan limits (used by later scanning tasks) ===
MAX_ZIP_SIZE_MB=100
MAX_FILES_PER_SCAN=10000
MAX_LINES_PER_FILE=10000
SCAN_TIMEOUT_SECONDS=600
SANDBOX_MEMORY_MB=4096
SANDBOX_CPU_CORES=2
